# CloudNest — transactional email (OTP delivery) configuration
# ------------------------------------------------------------
# Copy this file to `backend/.env` (gitignored) and fill in your SMTP
# credentials. NEVER commit the real values.
#
# `MAIL_ENABLED=true` switches the auth-service to real SMTP delivery:
#   - the plaintext OTP is NEVER returned in API responses
#   - the `devOtp` fallback is disabled
# `MAIL_ENABLED=false` (default) keeps the development-mode `devOtp`
# response so local flows remain testable without an SMTP account.

# Gmail SMTP (real email delivery)
# Requires a Gmail account with 2-Step Verification enabled and an
# App Password generated for "Mail":
#   Google Account -> Security -> 2-Step Verification -> App passwords
# The app password is a 16-character code; never commit it.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
