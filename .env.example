# CloudNest — Production environment template
# ------------------------------------------------------------
# Copy this file to `.env` on the target host (gitignored) and fill in
# REAL values. NEVER commit real secrets — this file must contain
# placeholders only.
#
#   cp .env.example .env && $EDITOR .env
#
# Referenced by docker-compose.yml (root). Every variable used by the
# Compose stack is listed below.

# ---------- Database (MySQL) ----------
# NOTE: the current architecture uses the MySQL root account for all
# services; each service creates its own schema (auth_db, file_db, ...)
# on first boot. MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD are listed
# for completeness only and are NOT consumed by the stack today.
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
# MYSQL_DATABASE=cloudnest
# MYSQL_USER=cloudnest
# MYSQL_PASSWORD=change-me-app-password

# ---------- Object storage (MinIO) ----------
MINIO_ROOT_USER=cloudnest-admin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_NAME=cloudnest

# ---------- Auth / JWT ----------
# 32+ random characters, base64 or hex. Must match across auth-service,
# user-service and api-gateway (JWT is signed with this secret).
JWT_SECRET=generate-a-long-random-secret-here

# ---------- SMTP (Gmail OTP delivery) ----------
# Requires a Gmail account with 2-Step Verification + an App Password.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ---------- Razorpay (payments) ----------
# TEST mode keys (rzp_test_...) for staging; switch to rzp_live_... only
# when the production webhook URL is reachable and the account is active.
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- OAuth (Google / GitHub) ----------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://<cloudnest-domain>/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://<cloudnest-domain>/api/auth/oauth/github/callback
OAUTH_FRONTEND_BASE_URL=https://<cloudnest-domain>
